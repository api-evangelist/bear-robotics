          "id": "03b6a439-981b-4128-9847-3e7288be00bf",
          "name": "API Service Localize Robot",
          "request": {
            "name": "API Service Localize Robot",
            "description": {
              "content": "Localizes the robot to a known pose or destination.\n\n While the robot is localizing,\n any subsequent requests to localize the robot will return a\n FAILED_PRECONDITION error until the process is completed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "robot",
                "localize"
