          "name": "API Service Calibrate Trays",
          "request": {
            "name": "API Service Calibrate Trays",
            "description": {
              "content": "Calibrate the trays on the robot.\n\n Only applicable for tray-equipped robots (e.g., Servi, Servi Plus).\n\n Calibrates all trays if no tray names are provided.\n Returns an INVALID_ARGUMENT error and rejects the request if any tray name\n is invalid.\n Returns an empty response on success.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "trays",
                "calibrate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"robotId\": \"<string>\",\n  \"selector\": {\n    \"trayNames\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
