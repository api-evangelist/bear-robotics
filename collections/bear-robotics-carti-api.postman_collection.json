          "id": "5b47f99f-8ab6-4346-b18a-9a9ac439b8ab",
          "name": "API Service Get Conveyor Index",
          "request": {
            "name": "API Service Get Conveyor Index",
            "description": {
              "content": "Retrieves the configured conveyor indexes for the robot.\n\n Indexes represent logical positions, not physical installation:\n - Carti 100 (vertical): INDEX_1ST = uppermost conveyor\n - Carti 600 (horizontal): INDEX_1ST = front facing conveyor",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "conveyor-index",
                "get"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
