        {
          "id": "a2e7e786-1eac-4abf-9b22-57c95e8f63a8",
          "name": "API Service Control Conveyor",
          "request": {
            "name": "API Service Control Conveyor",
            "description": {
              "content": "Control conveyor motor operations for the specified conveyor indexes.\n\n This call allows manual control of conveyor motors for\n clockwise/counter-clockwise rotation or stop commands.\n\n This call will fail if:\n - Any specified conveyor index is not installed on the robot.\n - The robot is in an error state that prevents conveyor control.\n\n Notes:\n - Carti 100: CW = right, CCW = left (X-axis rotation)\n - Carti 600: CW = front→rear, CCW = rear→front (Y-axis rotation)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "conveyor",
                "control"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"robotId\": \"<string>\",\n  \"commands\": [\n    {\n      \"index\": \"<integer>\",\n      \"command\": \"<enum>\"\n    },\n    {\n      \"index\": \"<integer>\",\n      \"command\": \"<enum>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
